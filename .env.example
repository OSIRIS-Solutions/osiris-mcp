# Base URL of an OSIRIS installation, without a trailing slash.
OSIRIS_BASE_URL=https://osiris.example.org

# Client ID and secret created in OSIRIS under Settings > API clients.
OSIRIS_CLIENT_ID=osc_replace-me

# The secret is sent in the X-API-Key header, never in the URL.
OSIRIS_API_KEY=replace-me
# For Docker/Kubernetes secrets, remove OSIRIS_API_KEY and use instead:
# OSIRIS_API_KEY_FILE=/run/secrets/osiris_api_key

OSIRIS_TIMEOUT_SECONDS=15

# Public repository containing the exact source code of the deployed MCP server.
# Required when a modified version is offered over a network (AGPL section 13).
OSIRIS_MCP_SOURCE_URL=https://example.org/source/osiris-mcp

# The command-line package defaults to stdio. compose.yaml overrides these
# values with a local-only Streamable HTTP endpoint inside the container.
OSIRIS_MCP_TRANSPORT=stdio
OSIRIS_MCP_HOST=127.0.0.1
OSIRIS_MCP_PORT=8000
OSIRIS_MCP_PATH=/mcp

# Host port used by compose.yaml. It is always published on 127.0.0.1.
OSIRIS_MCP_PUBLISHED_PORT=8765
