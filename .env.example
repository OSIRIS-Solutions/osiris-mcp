# Base URL of an OSIRIS installation, without a trailing slash.
OSIRIS_BASE_URL=https://osiris.example.org

# Client ID and secret created in OSIRIS under Settings > API clients.
OSIRIS_CLIENT_ID=osc_replace-me

# The secret is sent in the X-API-Key header, never in the URL.
OSIRIS_API_KEY=replace-me

OSIRIS_TIMEOUT_SECONDS=15
