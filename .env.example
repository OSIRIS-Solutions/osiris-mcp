# Base URL of an OSIRIS installation, without a trailing slash.
OSIRIS_BASE_URL=https://osiris.example.org

# Client ID and secret created in OSIRIS under Settings > API clients.
OSIRIS_CLIENT_ID=osc_replace-me

# The secret is sent in the X-API-Key header, never in the URL.
OSIRIS_API_KEY=replace-me
# For Docker/Kubernetes secrets, remove OSIRIS_API_KEY and use instead:
# OSIRIS_API_KEY_FILE=/run/secrets/osiris_api_key

OSIRIS_TIMEOUT_SECONDS=15

# Public repository containing the exact source code of the deployed MCP server.
# Required when a modified version is offered over a network (AGPL section 13).
OSIRIS_MCP_SOURCE_URL=https://example.org/source/osiris-mcp

# The command-line package defaults to stdio. compose.yaml overrides these
# values with a local-only Streamable HTTP endpoint inside the container.
OSIRIS_MCP_TRANSPORT=stdio
OSIRIS_MCP_HOST=127.0.0.1
OSIRIS_MCP_PORT=8000
OSIRIS_MCP_PATH=/mcp

# Host port used by compose.yaml. It is always published on 127.0.0.1.
OSIRIS_MCP_PUBLISHED_PORT=8765

# Inbound MCP authentication: none (local loopback only), api-key, or oauth.
OSIRIS_MCP_AUTH_MODE=none

# Simple internal mode. Generate at least 32 random characters and send it as
# `Authorization: Bearer <key>`. Prefer the _FILE variant in containers.
# OSIRIS_MCP_API_KEY=replace-with-a-long-random-value
# OSIRIS_MCP_API_KEY_FILE=/run/secrets/osiris_mcp_api_key

# Standards-based remote mode. OSIRIS MCP is the OAuth resource server; the
# configured identity provider remains responsible for login and token issue.
# OSIRIS_MCP_PUBLIC_URL=https://mcp.example.org/mcp
# OSIRIS_MCP_OAUTH_ISSUER_URL=https://login.example.org/realms/osiris
# OSIRIS_MCP_OAUTH_INTROSPECTION_URL=https://login.example.org/realms/osiris/protocol/openid-connect/token/introspect
# OSIRIS_MCP_OAUTH_CLIENT_ID=osiris-mcp
# OSIRIS_MCP_OAUTH_CLIENT_SECRET=replace-me
# OSIRIS_MCP_OAUTH_CLIENT_SECRET_FILE=/run/secrets/oauth_client_secret
# OSIRIS_MCP_OAUTH_REQUIRED_SCOPES=osiris:read
# OSIRIS_MCP_OAUTH_AUDIENCE=https://mcp.example.org/mcp

# Local Docker development only: compose.local-oauth.yaml uses this internal
# URL while browsers continue to discover the public issuer from above.
# OSIRIS_MCP_DOCKER_OAUTH_INTROSPECTION_URL=http://host.docker.internal:8080/realms/osiris/protocol/openid-connect/token/introspect
# OSIRIS_MCP_DOCKER_OAUTH_HOST_HEADER=127.0.0.1:8080

# Override DNS-rebinding allow-lists only when a proxy or internal hostname
# requires it. Comma-separated values; wildcards such as mcp.example.org:* work.
# OSIRIS_MCP_ALLOWED_HOSTS=mcp.example.org:*
# OSIRIS_MCP_ALLOWED_ORIGINS=https://mcp.example.org:*
